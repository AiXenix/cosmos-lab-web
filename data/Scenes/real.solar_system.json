 "assumptions": [
  {
   "id": "ssb_not_recentred",
   "text": {
    "en": "States are the original Solar-System-barycentre vectors. The ten-body subset has a small residual barycentre velocity (listed in frame); the core may subtract it explicitly as a Galilean change of frame.",
    "ru": "Состояния — исходные векторы относительно барицентра Солнечной системы. У подмножества из десяти тел есть малая остаточная скорость барицентра (указана в frame); ядро может явно вычесть её галилеевым преобразованием."
   },
   "affects": [
    "frame"
   ]
  },
  {
   "id": "subset_only",
   "text": {
    "en": "Only ten bodies: other moons, dwarf planets and small bodies are absent, so long-term positions drift from the real ephemeris.",
    "ru": "Только десять тел: остальные спутники, карликовые планеты и малые тела отсутствуют, поэтому со временем положения расходятся с реальной эфемеридой."
   },
   "affects": [
    "bodies"
   ]
  },
  {
   "id": "no_gr",
   "text": {
    "en": "Newtonian dynamics: Mercury's relativistic perihelion advance (43 arcsec/century) is absent.",
